<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Assimp</RootNamespace>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsOfficialBuild)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Assimp.Maui</PackageId>
		<Version>6.0.5.0-rc3</Version>
		<AssemblyVersion>6.0.5.0</AssemblyVersion>
		<FileVersion>6.0.5.0</FileVersion>
		<Title>Assimp.Maui</Title>
		<Authors>Weslley Murdock</Authors>
		<Company>Remote Code Hub</Company>
		<PackageReleaseNotes>
		- 🐞 BugFix: windows namespaces werent working
		</PackageReleaseNotes>
		<Copyright>Copyright ©2026 Remote Code Hub</Copyright>
		<PackageTags>assimp;net;maui;native;assimp-net;android;ios;windows;maccatalyst;scene;game;game-dev;engine;assets;asset;3d</PackageTags>
		<Description>**Assimp.MAUI** is a .NET MAUI wrapper and cross-platform binary distribution for the [Open Asset Import Library (Assimp)](https://github.com/assimp/assimp). This package bundles pre-compiled native Assimp binaries targeting all .NET MAUI supported platforms and Runtime Identifiers (RIDs), enabling seamless loading and processing of over 40 3D model formats (such as OBJ, FBX, GLTF, COLLADA, and STL) in cross-platform applications.</Description>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/weslleymurdock/Assimp.MAUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/weslleymurdock/Assimp.MAUI.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>icon.png</PackageIcon>
		<PackageIconUrl>https://raw.githubusercontent.com/weslleymurdock/Assimp.MAUI/main/src/icon.png</PackageIconUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
	</ItemGroup>

	<ItemGroup>
		<!-- Arquivos de raiz (Sem barra inicial no PackagePath) -->
		<None Include="../../icon.png" Pack="true" PackagePath="icon.png" />
		<None Include="../../LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
		<None Include="../../README.md" Pack="true" PackagePath="README.md" />

		<None Include="build/Assimp.Maui.targets" Pack="true" PackagePath="build/" />

		<None Include="Platforms/Android/runtimes/android-arm/native/**/*.*" Pack="true" PackagePath="runtimes/android-arm/native/" />
		<None Include="Platforms/Android/runtimes/android-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/android-arm64/native/" />
		<None Include="Platforms/Android/runtimes/android-x86/native/**/*.*" Pack="true" PackagePath="runtimes/android-x86/native/" />
		<None Include="Platforms/Android/runtimes/android-x86_64/native/**/*.*" Pack="true" PackagePath="runtimes/android-x86_64/native/" />

		<None Include="Platforms/iOS/runtimes/ios-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/ios-arm64/native/" />
		<None Include="Platforms/iOS/runtimes/iossimulator-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/iossimulator-arm64/native/" />
		<None Include="Platforms/iOS/runtimes/iossimulator-x64/native/**/*.*" Pack="true" PackagePath="runtimes/iossimulator-x64/native/" />

		<None Include="Platforms/MacCatalyst/runtimes/maccatalyst-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/maccatalyst-arm64/native/" />
		<None Include="Platforms/MacCatalyst/runtimes/maccatalyst-x64/native/**/*.*" Pack="true" PackagePath="runtimes/maccatalyst-x64/native/" />

		<None Include="Platforms/Windows/runtimes/win-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/win-arm64/native/" />
		<None Include="Platforms/Windows/runtimes/win-x64/native/**/*.*" Pack="true" PackagePath="runtimes/win-x64/native/" />
 
	</ItemGroup>

</Project>
