<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assimp.MAUI.Sample.ShaderPlaygroundPage"
             Title="Shader Playground">
  <Grid Padding="10" RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <VerticalStackLayout>
        <Label Text="Shader Playground" FontSize="24" FontAttributes="Bold" />
        <Label Text="Edit GLSL, compile it in WebGL, and preview it on the imported mesh."
               Opacity="0.7" />
      </VerticalStackLayout>
      <Picker x:Name="ShaderPicker" Grid.Column="1" WidthRequest="220"
              Title="Shader example" SelectedIndexChanged="OnShaderSelected" />
    </Grid>

    <WebView x:Name="ShaderView" Grid.Row="1" />

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Label x:Name="ConsoleLabel" Text="Console: ready" LineBreakMode="TailTruncation" />
      <Button Grid.Column="1" Text="Compile" Clicked="OnCompileClicked" />
      <Button Grid.Column="2" Text="Reset shader" Clicked="OnResetShaderClicked" />
    </Grid>
  </Grid>
</ContentPage>
